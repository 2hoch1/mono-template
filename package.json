{
  "$schema": "https://json.schemastore.org/package",
  "name": "ts-monorepo-template",
  "version": "0.0.0",
  "description": "A TypeScript monorepo template.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">= 24.14.0",
    "pnpm": ">=10"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "build:dev": "pnpm -r --if-present build:dev",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "pnpm -r --if-present lint",
    "lint:fix": "pnpm -r --if-present lint:fix",
    "test": "pnpm -r --if-present test",
    "format": "pnpm -r --if-present format && prettier --write --no-error-on-unmatched-pattern \".github/**/*.{yml,yaml,json,md}\" \"*.{json,md,yml,yaml}\"",
    "format:check": "pnpm -r --if-present format:check && prettier --check --no-error-on-unmatched-pattern \".github/**/*.{yml,yaml,json,md}\" \"*.{json,md,yml,yaml}\"",
    "version": "pnpm changeset version && pnpm install --lockfile-only",
    "release": "pnpm run build && pnpm changeset publish",
    "prepare": "husky"
  },
  "packageManager": "pnpm@11.3.0",
  "dependencies": {},
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@commitlint/cli": "^19.0.0",
    "@commitlint/config-conventional": "^19.0.0",
    "@eslint/js": "^9.0.0",
    "typescript-eslint": "^8.52.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "husky": "^9.0.0",
    "lint-staged": "^15.0.0",
    "prettier": "^3.0.0",
    "typescript": "^6.0.3"
  }
}
